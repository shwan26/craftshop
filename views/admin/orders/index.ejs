<%- include("../../partials/head") %>
<%- include("../../partials/navbar") %>
<%- include("../../partials/messages") %>

<main>
  <section class="page-header">
    <div class="container">
      <p class="section-label">Administration</p>

      <div
        class="d-flex flex-wrap justify-content-between align-items-end gap-3"
      >
        <div>
          <h1 class="display-5 fw-bold mb-2">
            Manage Orders
          </h1>

          <p class="text-secondary mb-0">
            Review customer projects and update their progress.
          </p>
        </div>

        <a
          href="/admin"
          class="btn btn-outline-dark"
        >
          Admin Dashboard
        </a>
      </div>
    </div>
  </section>

  <section class="orders-section">
    <div class="container">
      <form
        action="/admin/orders"
        method="GET"
        class="admin-filter"
      >
        <label
          for="status"
          class="form-label fw-bold mb-0"
        >
          Filter by status
        </label>

        <select
          id="status"
          name="status"
          class="form-select"
        >
          <option value="">All statuses</option>

          <% allowedOrderStatuses.forEach((status) => { %>
            <option
              value="<%= status %>"
              <%= selectedStatus === status ? "selected" : "" %>
            >
              <%= status.replace("-", " ") %>
            </option>
          <% }) %>
        </select>

        <button class="btn btn-primary" type="submit">
          Apply
        </button>
      </form>

      <% if (orders.length === 0) { %>
        <div class="empty-cart mt-4">
          <h2 class="h3 fw-bold">No orders found</h2>

          <p class="text-secondary mb-0">
            There are no orders matching this filter.
          </p>
        </div>
      <% } else { %>
        <div class="order-list mt-4">
          <% orders.forEach((order) => { %>
            <article class="order-list-card">
              <div class="order-list-main">
                <div>
                  <p class="order-number mb-1">
                    <%= order.orderNumber %>
                  </p>

                  <h2 class="h5 fw-bold mb-2">
                    <%= order.user?.name || "Unknown customer" %>
                  </h2>

                  <p class="text-secondary small mb-0">
                    <%= order.user?.email || order.contactEmail %>
                    ·
                    <%= order.items.length %>
                    <%= order.items.length === 1
                      ? "service"
                      : "services" %>
                  </p>
                </div>

                <div class="order-list-side">
                  <span
                    class="status-badge status-<%= order.status %>"
                  >
                    <%= order.status.replace("-", " ") %>
                  </span>

                  <strong>
                    $<%= Number(order.total).toFixed(2) %>
                  </strong>
                </div>
              </div>

              <div class="order-list-footer">
                <span>
                  Created
                  <%= new Date(
                    order.createdAt
                  ).toLocaleString() %>
                </span>

                <a
                  href="/admin/orders/<%= order._id %>"
                  class="btn btn-sm btn-outline-dark"
                >
                  Manage Order
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include("../../partials/footer") %>