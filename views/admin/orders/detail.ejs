<%- include("../../partials/head") %>
<%- include("../../partials/navbar") %>
<%- include("../../partials/messages") %>

<main>
  <section class="page-header">
    <div class="container">
      <a
        href="/admin/orders"
        class="back-link dark-back-link"
      >
        <i class="bi bi-arrow-left"></i>
        Back to orders
      </a>

      <div
        class="d-flex flex-wrap justify-content-between align-items-end gap-3 mt-4"
      >
        <div>
          <p class="section-label">
            <%= order.orderNumber %>
          </p>

          <h1 class="display-5 fw-bold mb-2">
            Manage Order
          </h1>

          <p class="text-secondary mb-0">
            Customer:
            <%= order.user?.name || "Unknown" %>
          </p>
        </div>

        <span
          class="status-badge status-<%= order.status %>"
        >
          <%= order.status.replace("-", " ") %>
        </span>
      </div>
    </div>
  </section>

  <section class="orders-section">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="checkout-panel">
            <p class="section-label">Purchased services</p>

            <h2 class="h4 fw-bold mb-4">
              Order items
            </h2>

            <div class="checkout-items">
              <% order.items.forEach((item) => { %>
                <article class="checkout-item">
                  <div>
                    <p class="cart-service-link mb-1">
                      <%= item.serviceTitle %>
                    </p>

                    <h3 class="h6 fw-bold">
                      <%= item.packageName %> Package
                    </h3>

                    <p class="text-secondary small mb-0">
                      Delivery:
                      <%= item.deliveryDays %>
                      <%= item.deliveryDays === 1
                        ? "day"
                        : "days" %>
                    </p>
                  </div>

                  <strong>
                    $<%= Number(item.price).toFixed(2) %>
                  </strong>
                </article>
              <% }) %>
            </div>
          </div>

          <div class="checkout-panel mt-4">
            <p class="section-label">
              Project requirements
            </p>

            <h2 class="h4 fw-bold mb-4">
              Project brief
            </h2>

            <p class="project-brief mb-0">
              <%= order.projectBrief %>
            </p>
          </div>
          <div class="mt-4">
            <%- include("../../partials/order-timeline", {
                order
            }) %>
            </div>

            <div class="mt-4">
            <%- include("../../partials/order-workspace", {
                order
            }) %>
            </div>
        </div>

        <div class="col-lg-4">
          <aside class="order-summary">
            <p class="section-label mb-2">
              Administration
            </p>

            <h2 class="h4 fw-bold">
              Update status
            </h2>

            <form
              action="/admin/orders/<%= order._id %>/status"
              method="POST"
              class="mt-4"
            >
              <label
                for="status"
                class="form-label text-white fw-bold"
              >
                Order status
              </label>

              <select
                id="status"
                name="status"
                class="form-select"
                required
              >
                <% allowedOrderStatuses.forEach((status) => { %>
                  <option
                    value="<%= status %>"
                    <%= order.status === status ? "selected" : "" %>
                  >
                    <%= status.replace("-", " ") %>
                  </option>
                <% }) %>
              </select>

              <div class="mt-3">
                <label
                for="statusNote"
                class="form-label text-white fw-bold"
                >
                Progress note
                </label>

                <textarea
                id="statusNote"
                name="statusNote"
                class="form-control"
                rows="3"
                maxlength="500"
                placeholder="Optional note for the customer"
                ></textarea>
            </div>

              <button
                type="submit"
                class="btn btn-primary w-100 mt-3"
              >
                Save Status
              </button>
            </form>

            <hr>

            <dl class="order-meta">
              <div>
                <dt>Customer</dt>
                <dd><%= order.user?.name || "Unknown" %></dd>
              </div>

              <div>
                <dt>Email</dt>
                <dd>
                  <%= order.user?.email || order.contactEmail %>
                </dd>
              </div>

              <div>
                <dt>Created</dt>
                <dd>
                  <%= new Date(
                    order.createdAt
                  ).toLocaleString() %>
                </dd>
              </div>
            </dl>

            <hr>

            <div class="summary-total">
              <span>Total</span>

              <strong>
                $<%= Number(order.total).toFixed(2) %>
              </strong>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("../../partials/footer") %>