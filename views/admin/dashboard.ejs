<%- include("../partials/head") %>
<%- include("../partials/navbar") %>
<%- include("../partials/messages") %>

<main>
  <section class="dashboard-header">
    <div class="container">
      <p class="section-label">Administration</p>

      <h1 class="display-5 fw-bold">
        CraftShop Command Center
      </h1>

      <p class="dashboard-intro mb-0">
        Manage customers, services, and active projects.
      </p>
    </div>
  </section>

  <section class="dashboard-section">
    <div class="container">
      <div class="admin-actions mb-4">
        <a
          href="/admin/orders"
          class="btn btn-primary"
        >
          <i class="bi bi-receipt me-2"></i>
          Manage Orders
        </a>

        <a
          href="/admin/services"
          class="btn btn-outline-dark"
        >
          <i class="bi bi-grid me-2"></i>
          Manage Services
        </a>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-xl-3">
          <article class="dashboard-stat">
            <span>Users</span>
            <strong><%= userCount %></strong>
            <i class="bi bi-people"></i>
          </article>
        </div>

        <div class="col-md-6 col-xl-3">
          <article class="dashboard-stat">
            <span>Services</span>
            <strong><%= serviceCount %></strong>
            <i class="bi bi-grid"></i>
          </article>
        </div>

        <div class="col-md-6 col-xl-3">
          <article class="dashboard-stat">
            <span>Total orders</span>
            <strong><%= orderCount %></strong>
            <i class="bi bi-receipt"></i>
          </article>
        </div>

        <div class="col-md-6 col-xl-3">
          <article class="dashboard-stat">
            <span>Active orders</span>
            <strong><%= pendingOrderCount %></strong>
            <i class="bi bi-tools"></i>
          </article>
        </div>
      </div>

      <div class="dashboard-panel mt-5">
        <div
          class="d-flex flex-wrap justify-content-between align-items-center gap-3"
        >
          <div>
            <p class="section-label mb-1">
              Latest activity
            </p>

            <h2 class="h3 fw-bold mb-0">
              Recent orders
            </h2>
          </div>

          <a
            href="/admin/orders"
            class="btn btn-outline-dark"
          >
            View All
          </a>
        </div>

        <% if (recentOrders.length === 0) { %>
          <p class="text-secondary mt-4 mb-0">
            No orders have been placed yet.
          </p>
        <% } else { %>
          <div class="table-responsive mt-4">
            <table class="table align-middle dashboard-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Customer</th>
                  <th>Status</th>
                  <th>Total</th>
                  <th></th>
                </tr>
              </thead>

              <tbody>
                <% recentOrders.forEach((order) => { %>
                  <tr>
                    <td>
                      <strong><%= order.orderNumber %></strong>

                      <small>
                        <%= new Date(
                          order.createdAt
                        ).toLocaleDateString() %>
                      </small>
                    </td>

                    <td>
                      <%= order.user?.name || "Unknown" %>

                      <small>
                        <%= order.user?.email || "" %>
                      </small>
                    </td>

                    <td>
                      <span
                        class="status-badge status-<%= order.status %>"
                      >
                        <%= order.status.replace("-", " ") %>
                      </span>
                    </td>

                    <td>
                      $<%= Number(order.total).toFixed(2) %>
                    </td>

                    <td class="text-end">
                      <a
                        href="/admin/orders/<%= order._id %>"
                        class="btn btn-sm btn-outline-dark"
                      >
                        Open
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>