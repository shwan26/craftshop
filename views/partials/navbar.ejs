<nav class="navbar navbar-expand-lg navbar-dark craft-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <span class="brand-icon">
        <i class="bi bi-stars"></i>
      </span>

      CraftShop
    </a>

    <button
