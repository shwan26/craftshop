<%- include("partials/head", { bodyClass: "ascii-home" }) %>
<%- include("partials/navbar") %>
<%- include("partials/messages") %>

<div class="ascii-entry" aria-hidden="true">
  <div class="ascii-entry__content">
    <span class="ascii-entry__mark">[ C/S ]</span>
    <span class="ascii-entry__name">CRAFTSHOP</span>
    <span class="ascii-entry__status">INITIALIZING CREATIVE SYSTEM...</span>
    <span class="ascii-entry__bar">[<i></i>]</span>
  </div>
</div>

<main class="ascii-main">
  <section class="ascii-hero" aria-labelledby="hero-title">
    <div class="ascii-sky" aria-hidden="true"></div>

    <div class="ascii-sun" aria-hidden="true">
      <span>\ | /</span>
      <span>— ( ) —</span>
      <span>/ | \</span>
    </div>

    <div class="ascii-hero__copy">

      <p class="ascii-eyebrow">Independent digital craft studio</p>
      <h1 id="hero-title">
        Ideas, built
        <span>with intention.</span>
      </h1>
      <p class="ascii-intro">
        Websites, visual design, and career tools made for
        people with something worth sharing.
      </p>

      <div class="ascii-actions">
        <a href="/services" class="ascii-button">
          Explore services <span aria-hidden="true">→</span>
        </a>
        <a href="#selected-work" class="ascii-text-link">
          See what we make ↓
        </a>
      </div>
    </div>

    <div class="ascii-landscape" aria-hidden="true">
      <pre class="ascii-cloud ascii-cloud--one">
            .----.
        _.-'      '-._
    _.-'   .--.       '-._
_.-'____.-'    '-.________'-._
      </pre>
      <pre class="ascii-cloud ascii-cloud--two">
        .---.             .---.
    _.-'     '-._____.--'     '-._
_.-'      .-.              .-.    '-._
________.-' '-.__________.-' '-._______
      </pre>
      <pre class="ascii-cloud ascii-cloud--three">
         .----.
     _.-'      '-.__
_.--'    .--.       '---._
______.-'    '-.___________
      </pre>
      <div class="ascii-ground">
        ........................................................................................................................
        <span>_/\____/\_______/\____/\______/\________/\_____/\_____/\_______/\____</span>
      </div>
    </div>

    <a href="#selected-work" class="ascii-scroll">
      <span>SCROLL TO EXPLORE</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <section class="ascii-services" id="selected-work">
    <div class="container">
      <div class="ascii-section-heading">
        <div>
          <p>SELECTED SERVICES</p>
          <h2>Useful things,<br>carefully made.</h2>
        </div>
        <p class="ascii-section-note">
          Clear process. Thoughtful details.<br>
        </p>
      </div>

      <div class="ascii-service-grid">
        <% featuredServices.forEach((service) => { %>
          <article class="ascii-service-card">
            <div class="ascii-card-top">
              <span>0<%= featuredServices.indexOf(service) + 1 %></span>
              <span class="ascii-card-icon">
                <i class="bi <%= service.icon %>"></i>
              </span>
            </div>
            <div>
              <h3><%= service.title %></h3>
              <p><%= service.description %></p>
            </div>
            <div class="ascii-card-footer">
              <span>FROM $<%= service.price %></span>
              <a href="/services" aria-label="View <%= service.title %>">↗</a>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="ascii-cta">
        <div aria-hidden="true" class="ascii-cta-art">
          <span>+-------+</span>
          <span>| MAKE  |----&gt; [ SOMETHING GOOD ]</span>
          <span>+-------+</span>
        </div>
        <div>
          <p>HAVE A PROJECT IN MIND?</p>
          <h2>Let’s make it real.</h2>
        </div>
        <a href="/services" class="ascii-button ascii-button--light">
          Start a project <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</main>

<noscript>
  <style>
    .ascii-entry {
      display: none;
    }
  </style>
</noscript>

<%- include("partials/footer") %>
